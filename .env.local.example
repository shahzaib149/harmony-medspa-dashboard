# Uses the existing server-only AIRTABLE_LEADS_BASE_ID and AIRTABLE_API_KEY.
# Reactivation reads Patients and Reactivation Enrollments by table name.
# No additional table-ID environment variables are required.
# Shared with the Make reactivation scenario to sign unsubscribe links (24+ alphanumeric characters).
REACTIVATION_UNSUBSCRIBE_SECRET=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_SECRET
# Public site that hosts the patient unsubscribe page (defaults to https://www.harmonymedspafl.com).
REACTIVATION_UNSUBSCRIBE_BASE_URL=https://www.harmonymedspafl.com
