# Airtable
AIRTABLE_API_KEY=
AIRTABLE_LEADS_BASE_ID=
AIRTABLE_BASE_ID=
# Optional: defaults to AIRTABLE_LEADS_BASE_ID and a table named "Blogs"
AIRTABLE_BLOGS_BASE_ID=
AIRTABLE_BLOGS_TABLE_ID=tbltyc852o1xnmyEi
AIRTABLE_BLOGS_TABLE_NAME=Blogs

# App URL
NEXT_PUBLIC_APP_URL=https://harmony-medspa-dashboard.vercel.app
# Public website origin used for blog canonicals and SEO previews
NEXT_PUBLIC_SITE_URL=https://harmony-medspa.vercel.app
# Shared with the public website; used only to purge published-blog caches.
BLOG_REVALIDATE_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google OAuth2
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Google Ads
GOOGLE_ADS_API_VERSION=v21
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_MCC_ID=

# Google Business Profile
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# OpenAI (AI Suggestions tab)
OPENAI_API_KEY=

# MailChimp
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=

# Make.com
MAKE_WEBHOOK_SECRET=

# Lead Capture Form (app/lead)
NEXT_PUBLIC_MAKE_WEBHOOK_URL=
NEXT_PUBLIC_PATIENTNOW_BOOKING_URL=

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-11396978687
NEXT_PUBLIC_GOOGLE_ADS_LEAD_SEND_TO=AW-11396978687/R0vKCKrFz9kcEP-vwLoq

# Google Analytics Data API (server-only website reporting)
# Use the numeric property ID, not the G- measurement ID.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_EMAIL=
GA4_SERVICE_ACCOUNT_PRIVATE_KEY=

# In production, NEXT_PUBLIC_APP_URL must be the final public custom-domain origin.
# This keeps OAuth callbacks on the same domain as the website.
