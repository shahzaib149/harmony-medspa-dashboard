g: 12px 20px;\r\n                                color: #fff;\r\n                                font-size: 12px;\r\n                                font-weight: 700;\r\n                                text-decoration: none;\r\n                              \"\r\n                              >View lead in dashboard &nbsp;&rarr;</a\r\n                            >\r\n                          </td>\r\n                        </tr>\r\n                      </table>\r\n                    </td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n            </tr>\r\n            <tr>\r\n              <td\r\n                style=\"\r\n                  padding: 15px 28px;\r\n                  background: #faf8f2;\r\n                  border-top: 1px solid #d8c28f;\r\n                \"\r\n              >\r\n                <table\r\n                  role=\"presentation\"\r\n                  width=\"100%\"\r\n                  cellpadding=\"0\"\r\n                  cellspacing=\"0\"\r\n                >\r\n                  <tr>\r\n                    <td style=\"color: #737d82; font-size: 10px\">\r\n                      Harmony Med Spa · Lead Management\r\n                    </td>\r\n                    <td align=\"right\" style=\"color:#858b8e;font-family:Arial,sans-serif;font-size:10px;font-weight:700;letter-spacing:1.2px;\">MANAGED BY&nbsp;&nbsp; <a href=\"https://codesquad.ai\" target=\"_blank\" style=\"color:#a57412;font-size:15px;font-weight:700;letter-spacing:0;text-decoration:none;\">CodeSquad</a> <span style=\"color:#667078;font-size:9px;letter-spacing:1px;\">&nbsp;AI SOLUTIONS</span></td>\r\n                  </tr>\r\n                </table>\r\n              </td>\r\n            </tr>\r\n          </table>\r\n        </td>\r\n      </tr>\r\n    </table>\r\n  </body>\r\n</html>",
