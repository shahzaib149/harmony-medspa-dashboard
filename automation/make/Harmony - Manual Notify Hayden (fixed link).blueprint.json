\n                        role=\"presentation\"\r\n                        width=\"100%\"\r\n                        cellpadding=\"0\"\r\n                        cellspacing=\"0\"\r\n                        style=\"\r\n                          background: #fcfbf8;\r\n                          border: 1px solid #e7e1d5;\r\n                          border-radius: 11px;\r\n                        \"\r\n                      >\r\n                        <tr>\r\n                          <td\r\n                            colspan=\"4\"\r\n                            style=\"\r\n                              padding: 14px 16px 7px;\r\n                              color: #9b6b0b;\r\n                              font-size: 10px;\r\n                              font-weight: 700;\r\n                              letter-spacing: 1.7px;\r\n                            \"\r\n                          >\r\n                            LEAD DETAILS\r\n                          </td>\r\n                        </tr>\r\n                        <tr>\r\n                          <td\r\n                            width=\"18%\"\r\n                            style=\"\r\n                              padding: 7px 7px 7px 16px;\r\n                              color: #78848b;\r\n                              font-size: 12px;\r\n                            \"\r\n                          >\r\n                            Name\r\n                          </td>\r\n                          <td\r\n                            width=\"32%\"\r\n                            style=\"\r\n                              padding: 7px 10px 7px 0;\r\n                              font-size: 13px;\r\n                              font-weight: 700;\r\n                            \"\r\n                          >\r\n                            {{1.lead_name}}\r\n                          </td>\r\n                          <td\r\n                            width=\"17%\"\r\n                            sty